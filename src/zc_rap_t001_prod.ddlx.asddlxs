  headerInfo: {
    typeName: 'Product',
    typeNamePlural: 'Products',
    title: {
      type: #STANDARD,
      value: 'ProductName'
    },
    description: {
      type: #STANDARD,
      value: 'ProductId'
    }
  }
}
annotate view ZC_RAP_T001_PROD with
{
  @UI.hidden: true
  ProductUuid;

  @UI.facet: [
    {
      id: 'ProductInfo',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Product Information',
      position: 10
