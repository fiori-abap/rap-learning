  ProductId;

  @UI.lineItem: [{ position: 20, label: 'Product Name' }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20, label: 'Product Name' }]
  ProductName;

  @UI.lineItem: [{ position: 30, label: 'Price' }]
  @UI.identification: [{ position: 30, label: 'Price' }]
  Price;

  @UI.lineItem: [{ position: 40, label: 'Currency' }]
  @UI.identification: [{ position: 40, label: 'Currency' }]
  CurrencyCode;

  @UI.lineItem: [{ position: 50, label: 'Stock' }]
  @UI.identification: [{ position: 50, label: 'Stock' }]
  Stock;

  @UI.lineItem: [{ position: 60, label: 'Status' }]
  @UI.identification: [{ position: 60, label: 'Status' }]
  Status;

  @UI.hidden: true
  CreatedBy;

  @UI.hidden: true
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
