managed implementation in class zbp_i_rap_t006_h unique;
strict;
with draft;

define behavior for ZI_RAP_T006_H //alias <alias_name>
persistent table zrap_t006_h
draft table zrap_t006_hd
lock master
total etag LastChangedAt
authorization master ( instance )
//etag master <field_name>
{
  create;
  update;
  delete;
  association _Items { create; }

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zrap_t006_h
  {
    BatchID = batch_id;
    BatchName = batch_name;
    Description = description;
    Status = status;
    ProcessingDate = processing_date;
    ResponsiblePerson = responsible_person;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_RAP_T006_I //alias <alias_name>
