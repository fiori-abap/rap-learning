@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName       : '处理批次',
  typeNamePlural : '处理批次',
  title          : {
    type  : #STANDARD,
    value : 'BatchName'
  }
}

annotate entity ZC_RAP_T006_H with
{
  @UI.facet: [
    {
      id       : 'GeneralInfo',
      purpose  : #STANDARD,
      type     : #IDENTIFICATION_REFERENCE,
      label    : '基本信息',
      position : 10
    },
    {
      id       : 'Items',
      purpose  : #STANDARD,
      type     : #LINEITEM_REFERENCE,
      label    : '处理明细',
      position : 20,
      targetElement : '_Items'
    }
  ]

  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem:       [{ position: 10, label: '批次ID' }]
  @UI.identification: [{ position: 10, label: '批次ID' }]
  BatchID;

  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem:       [{ position: 20, label: '批次名称' }]
  @UI.identification: [{ position: 20, label: '批次名称' }]
  BatchName;

  @UI.lineItem:       [{ position: 30, label: '说明' }]
  @UI.identification: [{ position: 30, label: '说明' }]
  Description;

  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem:       [{ position: 40, label: '状态' }]
  @UI.identification: [{ position: 40, label: '状态' }]
  Status;

  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem:       [{ position: 50, label: '处理日期' }]
  @UI.identification: [{ position: 50, label: '处理日期' }]
  ProcessingDate;

  @UI.lineItem:       [{ position: 60, label: '负责人' }]
  @UI.identification: [{ position: 60, label: '负责人' }]
  ResponsiblePerson;

  @UI.lineItem:       [{ position: 70, label: '创建者' }]
  CreatedBy;

  @UI.lineItem:       [{ position: 80, label: '创建时间' }]
  CreatedAt;

  @UI.lineItem:       [{ position: 90, label: '最后修改者' }]
  LastChangedBy;

  @UI.lineItem:       [{ position: 100, label: '最后修改时间' }]
  LastChangedAt;
}